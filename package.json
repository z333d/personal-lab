{
  "name": "__LAB_NAME__",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" --filter \"./server\" dev",
    "build": "node scripts/build-lab.mjs",
    "deploy:root": "wrangler deploy --config server/wrangler.generated.jsonc",
    "deploy:all": "node scripts/deploy-all.mjs",
    "scaffold": "node scripts/scaffold.mjs"
  },
  "dependencies": {
    "@lab/lib": "workspace:*",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251201.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@json-render/ink>ink": "7",
        "@json-render/core>zod": "3"
      }
    }
  }
}

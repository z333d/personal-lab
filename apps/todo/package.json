{
  "name": "@lab/todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "theme:gen": "node scripts/gen-theme.mjs",
    "build": "pnpm theme:gen && vite build --mode client && vite build",
    "dev": "pnpm theme:gen && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@lab/lib": "workspace:*",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "better-auth": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.12.0",
    "lucide-react": "^0.488.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251201.0",
    "@google/design.md": "^0.1.0",
    "@hono/vite-build": "^1.6.0",
    "@hono/vite-dev-server": "^0.21.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "lab": {
    "title": "Todo",
    "description": "Example fullstack app — login + per-user todos. Uses Hono + React + D1 + Better Auth.",
    "fullstack": true,
    "framework": "hono-vite"
  }
}

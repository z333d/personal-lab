{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__LAB_NAME__-todo",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_BASE_PATH": "/apps/todo"
  },
  // Route binding injected by create-lab.mjs (placeholder is a no-op marker).
  "routes": "__APP_TODO_ROUTES__",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__LAB_NAME__-todo",
      "database_id": "__D1_TODO_ID__"
    }
  ]
  // Secrets (set via `wrangler secret put`):
  //   BETTER_AUTH_SECRET
  //   BETTER_AUTH_URL
}
